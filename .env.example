# ==============================================================================
# DAY 17: Python Email Automation - Environment Configuration
# ==============================================================================
# Rename this file to `.env` and fill in your actual credentials if you want to
# send/receive real emails. Otherwise, all scripts run safely in built-in
# Simulation Mode with zero external dependencies!
#
# IMPORTANT SECURITY NOTE:
# Never commit your `.env` file or hardcode your real password in source code!
# ==============================================================================

# --- Outgoing Mail Server (SMTP) Settings ---
# Common Providers:
#   Gmail:   smtp.gmail.com   (Port 587 with STARTTLS or 465 with SSL)
#   Outlook: smtp.office365.com (Port 587 with STARTTLS)
#   Yahoo:   smtp.mail.yahoo.com (Port 465 with SSL or 587 with STARTTLS)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
USE_TLS=true
USE_SSL=false

# Sender Account Credentials
# For Gmail: Use a 16-character Google App Password (NOT your regular password).
# Instructions: Google Account -> Security -> 2-Step Verification -> App Passwords.
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# Default Notification / Recipient Address for testing
DEFAULT_RECIPIENT=recipient@example.com

# --- Incoming Mail Server (IMAP) Settings ---
# Common Providers:
#   Gmail:   imap.gmail.com   (Port 993 with SSL)
#   Outlook: outlook.office365.com (Port 993 with SSL)
#   Yahoo:   imap.mail.yahoo.com (Port 993 with SSL)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16_char_app_password

# --- Automation Behavior Settings ---
# Set to 'false' to connect to real servers, or 'true' to run safely offline
SIMULATION_MODE=true

# Batch Dispatch Throttling (seconds delay between emails to avoid spam filters)
DISPATCH_DELAY_SECONDS=1.5
